# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=geeta_assessment
DB_USER=django
DB_PASSWORD=your-secure-password-here
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://django:password@postgres:5432/geeta_assessment

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@geetauniversity.edu.in
FRONTEND_URL=http://localhost:5173

# University Email Domain
UNIVERSITY_DOMAIN=geetauniversity.edu.in

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Docker Execution
DOCKER_IMAGE=gcc:11-bullseye
EXECUTION_TIMEOUT=10
EXECUTION_MEMORY_LIMIT=256m

# Logging
LOG_LEVEL=INFO

# Keep enabled while the legacy server-side Docker runner is in use.
SERVER_DOCKER_EXECUTION_ENABLED=true
