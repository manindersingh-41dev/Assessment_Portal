{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geeta Assessment Portal",
  "version": "2.0.0",
  "identifier": "in.geetauniversity.assessmentportal",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --strictPort --no-open",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "node scripts/check-desktop-env.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Geeta University Assessment Portal",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "base-uri": "'self'",
        "font-src": "'self' data:",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "object-src": "'none'",
        "form-action": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:8000 http://127.0.0.1:8000 ws://localhost:3000 ws://127.0.0.1:3000",
        "base-uri": "'self'",
        "font-src": "'self' data:",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http://localhost:8000 http://127.0.0.1:8000",
        "object-src": "'none'",
        "form-action": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "Geeta University coding assessment client",
    "longDescription": "Desktop client for Geeta University coding assessments."
  }
}
