# Django
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local example; replace credentials for your environment)
DATABASE_URL=postgresql://assessment_user:replace-me@localhost:5432/assessment_portal
DATABASE_SSL=False

# Frontend/API integration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email. Leave EMAIL_BACKEND on console for local development, or configure SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@geetauniversity.edu.in

# JWT token lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Legacy server-side runner settings. Requires a separately configured Docker daemon.
# Keep false when using client-side evaluation; server-side Docker submission evaluation was removed.
SERVER_DOCKER_EXECUTION_ENABLED=false
CODE_EXECUTION_TIMEOUT_SECONDS=30
CODE_EXECUTION_MAX_MEMORY_MB=128
